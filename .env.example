# Copy this file to .env and fill in your real keys. Never commit .env.
ELEVENLABS_API_KEY=your_elevenlabs_key_here
GROQ_API_KEY=your_groq_key_here

# Narrator voice (Matilda) and speed (0.7-1.2, 1.0 = normal). Also changeable in the Lab.
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_SPEED=0.8

ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
GROQ_MODEL=openai/gpt-oss-120b

# Frontend dev servers allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Reaction sound volume, 0.0-1.0. Also changeable in the Lab.
SOUND_VOLUME=0.5

# Database — omit for local SQLite at data/storybuddy.db.
# On Railway/Render/Fly, paste the Postgres URL they give you:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=